{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm --prefix servers/party-lab run build",
    "watchPatterns": ["/servers/party-lab/**", "/shared/party-lab/**"]
  },
  "deploy": {
    "startCommand": "npm --prefix servers/party-lab start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
