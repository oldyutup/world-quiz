# Optional override in root .env.local. Leave unset for automatic page-host LAN support.
# DEV example: http://192.168.1.34:5173 -> ws://192.168.1.34:2567
# VITE_PARTY_LAB_SERVER_URL=ws://192.168.1.34:2567

# Production values live in Vercel project settings, not in this repository.
# See servers/party-lab/DEPLOY.md.
# VITE_PARTY_LAB_SERVER_URL=wss://<railway-service>.up.railway.app
# Server-side only (Vercel middleware). Never prefix with VITE_.
# PARTY_LAB_ACCESS_SECRET=<output of: openssl rand -hex 32>
# PARTY_LAB_ACCESS_VERSION=1
