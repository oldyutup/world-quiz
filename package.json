{
  "name": "world-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && vite build --outDir dist-app --emptyOutDir && node scripts/prune-app-assets.mjs dist-app",
    "prune:app": "node scripts/prune-app-assets.mjs dist-app",
    "preview": "vite preview",
    "export:turkey-bg-guide": "tsx scripts/export-turkey-bg-guide.ts",
    "cap:sync": "npm run build:app && npx cap sync",
    "cap:copy": "npm run build:app && npx cap copy",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.105.1",
    "d3-geo": "^3.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.179.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.179.0",
    "@types/topojson-client": "^3.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "clipper-lib": "^6.4.2",
    "jpeg-js": "^0.4.4",
    "patch-package": "^8.0.1",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.0",
    "simplify-js": "^1.2.4",
    "svgpath": "^2.6.0",
    "tsx": "^4.22.3",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  }
}
